# Top-level Docker Compose variables.
# Copy to .env to customize before running `docker compose up`.

# ---- Postgres ----
POSTGRES_USER=soc2
POSTGRES_PASSWORD=soc2
POSTGRES_DB=soc2_reviewer
POSTGRES_PORT=5432

# ---- Service ports ----
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---- Optional local LLM (Ollama) ----
# Only exposed when starting with `--profile ollama`.
OLLAMA_PORT=11434
