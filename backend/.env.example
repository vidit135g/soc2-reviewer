# ---- Application ----
ENVIRONMENT=development
DEBUG=false
APP_NAME=SOC 2 Report Reviewer

# ---- Database (PostgreSQL with pgvector) ----
DATABASE_URL=postgresql+psycopg2://soc2:soc2@postgres:5432/soc2_reviewer

# ---- Upload handling ----
UPLOAD_DIR=/tmp/soc2-uploads
MAX_UPLOAD_MB=50

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- LLM provider ---------------------------------------------------------
# Choose one: ollama (default, fully local) | openai | anthropic | groq | stub
#
# Ollama runs in a sibling docker-compose service (behind the `ollama`
# profile) or on your host. It requires NO API key. With --profile ollama
# you get a fully open-source stack out of the box.
#
# To start Ollama:   docker compose --profile ollama up -d
# To pull the model: docker exec -it soc2-ollama ollama pull llama3.2:3b
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b

# ---- Paid provider API keys (only set the one you need) ------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ---- Ollama endpoint ------------------------------------------------------
# Inside docker-compose (with --profile ollama):   http://ollama:11434
# Using Ollama installed natively on your mac:     http://host.docker.internal:11434
# Running the backend outside docker:              http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434

# ---- Embeddings -----------------------------------------------------------
# local  — sentence-transformers in-process (BGE-small-en-v1.5, 384-dim).
#          No network at runtime, ~90 MB weights cached on first use.
# ollama — Ollama server with `nomic-embed-text` (768-dim). Pull first:
#          docker exec -it soc2-ollama ollama pull nomic-embed-text
# openai — hosted, 1536-dim (needs OPENAI_API_KEY).
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_MODEL=text-embedding-3-small

# Must match the active provider's native output dim:
#   local(BGE-small) = 384, ollama(nomic) = 768, openai(small) = 1536.
# Changing this after chunks exist requires dropping the chunks table.
EMBEDDING_DIMENSIONS=384

# ---- Semantic metadata augmentation --------------------------------------
# When true, the LLM fills in metadata fields the regex validator could not
# identify (paraphrased opinions, non-standard coverage windows, etc).
# Automatic no-op if no LLM provider is active.
SEMANTIC_AUGMENTATION=true

# ---- Retrieval tuning ----------------------------------------------------
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
TOP_K=6

# ---- Abuse protection ----------------------------------------------------
RATE_LIMIT_PER_MINUTE=30
